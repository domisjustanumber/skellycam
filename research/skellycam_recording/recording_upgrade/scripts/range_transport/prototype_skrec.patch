diff --git a/skellycam-ui/electron/main/playback/byte-range.ts b/skellycam-ui/electron/main/playback/byte-range.ts
new file mode 100644
index 000000000..5363e59db
--- /dev/null
+++ b/skellycam-ui/electron/main/playback/byte-range.ts
@@ -0,0 +1,39 @@
+/**
+ * HTTP Range header parsing for the recording protocol (T-S5 FINDINGS §6).
+ *
+ * Only a single byte range is supported; the player never sends multi-range
+ * requests, so those are answered 416 like any other range we won't serve.
+ */
+
+export type RangeRequest =
+    | { kind: 'whole' }
+    | { kind: 'partial'; start: number; end: number }  // inclusive, clamped to size - 1
+    | { kind: 'unsatisfiable' };
+
+const SINGLE_RANGE = /^bytes=(\d*)-(\d*)$/i;
+
+export function parseRangeHeader(header: string | null, size: number): RangeRequest {
+    if (header === null) return { kind: 'whole' };
+
+    const match = SINGLE_RANGE.exec(header.trim());
+    if (!match) return { kind: 'unsatisfiable' };
+    const [, first, last] = match;
+
+    let start: number;
+    let end: number;
+    if (first === '') {
+        if (last === '') return { kind: 'unsatisfiable' };
+        const suffixLength = Number(last);
+        if (suffixLength === 0) return { kind: 'unsatisfiable' };
+        start = Math.max(0, size - suffixLength);
+        end = size - 1;
+    } else {
+        start = Number(first);
+        end = last === '' ? size - 1 : Math.min(Number(last), size - 1);
+        if (!Number.isSafeInteger(start)) return { kind: 'unsatisfiable' };
+        if (last !== '' && Number(last) < start) return { kind: 'unsatisfiable' };
+    }
+
+    if (start >= size) return { kind: 'unsatisfiable' };
+    return { kind: 'partial', start, end };
+}
diff --git a/skellycam-ui/electron/main/playback/recording-grants.ts b/skellycam-ui/electron/main/playback/recording-grants.ts
new file mode 100644
index 000000000..e0fe77285
--- /dev/null
+++ b/skellycam-ui/electron/main/playback/recording-grants.ts
@@ -0,0 +1,150 @@
+/**
+ * Per-recording grants for the recording protocol (plan D20, option C).
+ *
+ * The page asks to open one recording folder; we list its media files and hand
+ * back a short id. Protocol URLs name files as `<id>/<name>`, and only names in
+ * that list are served, so there are no paths in URLs and nothing to traverse.
+ * File handles are opened on first read and kept until the grant closes.
+ */
+import fs from 'node:fs';
+import type { FileHandle } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+const CONTENT_TYPES: Record<string, string> = {
+    '.mkv': 'video/x-matroska',
+    '.mka': 'audio/x-matroska',
+    '.mp4': 'video/mp4',
+    '.mov': 'video/quicktime',
+    '.avi': 'video/x-msvideo',
+    '.webm': 'video/webm',
+    '.flac': 'audio/flac',
+    '.wav': 'audio/wav',
+    '.skfr': 'application/octet-stream',   // video timing sidecar (separate only until finalised)
+    '.skau': 'application/octet-stream',   // audio timing sidecar
+};
+
+// Old recordings keep their videos here (playback_router._find_video_folder).
+const SUBFOLDERS = ['synchronized_videos'];
+
+export interface RecordingFile {
+    name: string;   // relative to the recording folder, '/'-separated
+    size: number;
+}
+
+export interface Grant {
+    id: string;
+    recordingPath: string;
+    files: RecordingFile[];
+}
+
+export interface GrantedFile {
+    handle: FileHandle;
+    contentType: string;
+}
+
+interface GrantState {
+    id: string;
+    recordingPath: string;
+    files: Map<string, string>;                  // name -> absolute path
+    handles: Map<string, Promise<FileHandle>>;   // name -> open handle
+}
+
+function isRecordingMedia(fileName: string): boolean {
+    if (fileName.startsWith('.')) return false;
+    const lower = fileName.toLowerCase();
+    if (lower.endsWith('.web.mp4')) return false;   // old playback transcode copy (plan §2.9)
+    return path.extname(lower) in CONTENT_TYPES;
+}
+
+function expandHome(p: string): string {
+    return /^~([\\/]|$)/.test(p) ? path.join(os.homedir(), p.slice(1)) : p;
+}
+
+async function listMedia(recordingPath: string): Promise<Map<string, string>> {
+    const files = new Map<string, string>();
+    for (const prefix of ['', ...SUBFOLDERS]) {
+        const dir = path.join(recordingPath, prefix);
+        let entries: fs.Dirent[];
+        try {
+            entries = await fs.promises.readdir(dir, { withFileTypes: true });
+        } catch (error) {
+            if (prefix === '') throw error;
+            continue;   // optional subfolder absent
+        }
+        for (const entry of entries) {
+            if (entry.isFile() && isRecordingMedia(entry.name)) {
+                files.set(prefix ? `${prefix}/${entry.name}` : entry.name, path.join(dir, entry.name));
+            }
+        }
+    }
+    return files;
+}
+
+async function closeHandles(state: GrantState): Promise<void> {
+    const pending = [...state.handles.values()];
+    state.handles.clear();
+    // FileHandle.close() waits for reads already in flight on the handle.
+    await Promise.allSettled(pending.map(async h => (await h).close()));
+}
+
+export class RecordingGrants {
+    private nextId = 1;
+    private byId = new Map<string, GrantState>();
+    private byPath = new Map<string, GrantState>();
+
+    /** Grant access to one recording folder. Opening it again refreshes its file list and keeps its id. */
+    async open(recordingPath: string): Promise<Grant> {
+        const resolved = path.resolve(expandHome(recordingPath));
+        const files = await listMedia(resolved);
+        if (files.size === 0) throw new Error(`No media files in ${resolved}`);
+
+        let state = this.byPath.get(resolved);
+        if (state) {
+            await closeHandles(state);
+            state.files = files;
+        } else {
+            state = { id: `r${this.nextId++}`, recordingPath: resolved, files, handles: new Map() };
+            this.byId.set(state.id, state);
+            this.byPath.set(resolved, state);
+        }
+
+        const listed: RecordingFile[] = [];
+        for (const [name, absolute] of files) {
+            const { size } = await fs.promises.stat(absolute);
+            listed.push({ name, size });
+        }
+        return { id: state.id, recordingPath: resolved, files: listed };
+    }
+
+    async close(id: string): Promise<void> {
+        const state = this.byId.get(id);
+        if (!state) return;
+        this.byId.delete(id);
+        this.byPath.delete(state.recordingPath);
+        await closeHandles(state);
+    }
+
+    async closeAll(): Promise<void> {
+        await Promise.all([...this.byId.keys()].map(id => this.close(id)));
+    }
+
+    /** The open handle for a listed file, or null if the grant or name isn't known or the file is gone. */
+    async lookup(id: string, name: string): Promise<GrantedFile | null> {
+        const state = this.byId.get(id);
+        const absolute = state?.files.get(name);
+        if (!state || !absolute) return null;
+
+        let handle = state.handles.get(name);
+        if (!handle) {
+            handle = fs.promises.open(absolute, 'r');
+            state.handles.set(name, handle);
+        }
+        try {
+            return { handle: await handle, contentType: CONTENT_TYPES[path.extname(name).toLowerCase()] };
+        } catch {
+            state.handles.delete(name);   // e.g. deleted after open; let a later request retry
+            return null;
+        }
+    }
+}
diff --git a/skellycam-ui/electron/main/playback/recording-protocol.ts b/skellycam-ui/electron/main/playback/recording-protocol.ts
new file mode 100644
index 000000000..914bb3c8f
--- /dev/null
+++ b/skellycam-ui/electron/main/playback/recording-protocol.ts
@@ -0,0 +1,74 @@
+/**
+ * The `skrec://` protocol handler: serves recording files by byte range to the player
+ * (plan row 1.9, T-S5 FINDINGS §6). URLs are `skrec://<grant id>/<file name>`.
+ *
+ * It takes a standard Request and returns a Response, so it has no Electron
+ * dependency; `register.ts` wires it into `protocol.handle`.
+ */
+import { Readable } from 'node:stream';
+import { parseRangeHeader } from './byte-range.ts';
+import type { RecordingGrants } from './recording-grants.ts';
+
+export const RECORDING_SCHEME = 'skrec';
+
+// Above this, stream from the file instead of one positional read into a buffer.
+const SINGLE_READ_LIMIT = 8 * 1024 * 1024;
+
+const BASE_HEADERS = {
+    'Accept-Ranges': 'bytes',
+    // Chromium's HTTP cache fails 1-2 % of concurrent ranges to one URL without this (T-S5 §3).
+    'Cache-Control': 'no-store',
+    // The packaged page is file://; in dev it is the Vite origin, which needs these to read Content-Range.
+    'Access-Control-Allow-Origin': '*',
+    'Access-Control-Expose-Headers': 'Content-Range, Content-Length, Accept-Ranges',
+};
+
+function fileNameOf(url: URL): string | null {
+    try {
+        return decodeURIComponent(url.pathname.slice(1));
+    } catch {
+        return null;   // malformed percent-encoding
+    }
+}
+
+export function createRecordingProtocolHandler(grants: RecordingGrants) {
+    return async function handleRecordingRequest(req: Request): Promise<Response> {
+        if (req.method !== 'GET' && req.method !== 'HEAD') {
+            return new Response(null, { status: 405, headers: { ...BASE_HEADERS, Allow: 'GET, HEAD' } });
+        }
+
+        const url = new URL(req.url);
+        const name = fileNameOf(url);
+        const file = name === null ? null : await grants.lookup(url.hostname, name);
+        if (!file) return new Response(null, { status: 404, headers: BASE_HEADERS });
+
+        try {
+            const { size } = await file.handle.stat();   // per request: a file being finalised can grow
+            const headers: Record<string, string> = { ...BASE_HEADERS, 'Content-Type': file.contentType };
+            const range = parseRangeHeader(req.headers.get('range'), size);
+
+            if (range.kind === 'unsatisfiable') {
+                return new Response(null, { status: 416, headers: { ...headers, 'Content-Range': `bytes */${size}` } });
+            }
+
+            const [status, start, end] = range.kind === 'whole' ? [200, 0, size - 1] : [206, range.start, range.end];
+            const length = end - start + 1;
+            headers['Content-Length'] = String(length);
+            if (range.kind === 'partial') headers['Content-Range'] = `bytes ${start}-${end}/${size}`;
+
+            if (req.method === 'HEAD' || length === 0) return new Response(null, { status, headers });
+
+            if (length <= SINGLE_READ_LIMIT) {
+                const buffer = Buffer.allocUnsafe(length);
+                const { bytesRead } = await file.handle.read(buffer, 0, length, start);
+                return new Response(bytesRead === length ? buffer : buffer.subarray(0, bytesRead), { status, headers });
+            }
+            // autoClose false: the handle belongs to the grant, not to this stream.
+            const stream = file.handle.createReadStream({ start, end, autoClose: false });
+            return new Response(Readable.toWeb(stream) as ReadableStream, { status, headers });
+        } catch (error) {
+            console.error(`${RECORDING_SCHEME}: failed to serve ${req.url}:`, error);
+            return new Response(null, { status: 500, headers: BASE_HEADERS });
+        }
+    };
+}

+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readRange } from '../src/services/playback/range-reader.ts';
+
+type Fetch = typeof fetch;
+
+function fakeFetch(respond: (url: string, init: RequestInit) => Response | Promise<Response>) {
+    const calls: { url: string; init: RequestInit }[] = [];
+    const impl = (async (input: RequestInfo | URL, init: RequestInit = {}) => {
+        calls.push({ url: String(input), init });
+        return respond(String(input), init);
+    }) as Fetch;
+    return { impl, calls };
+}
+
+const bytes = (...values: number[]) => new Uint8Array(values);
+
+test('sends one bounded Range with the HTTP cache off', async () => {
+    const f = fakeFetch(() => new Response(bytes(1, 2, 3), { status: 206, headers: { 'Content-Range': 'bytes 10-12/100' } }));
+    await readRange('skrec://r1/cam0.mkv', 10, 3, f.impl);
+    assert.equal(new Headers(f.calls[0].init.headers).get('range'), 'bytes=10-12');
+    assert.equal(f.calls[0].init.cache, 'no-store');
+});
+
+test('206: returns the bytes and the total size', async () => {
+    const f = fakeFetch(() => new Response(bytes(1, 2, 3), { status: 206, headers: { 'Content-Range': 'bytes 10-12/100' } }));
+    assert.deepEqual(await readRange('skrec://r1/cam0.mkv', 10, 3, f.impl), { bytes: bytes(1, 2, 3), totalSize: 100 });
+});
+
+test('206 near EOF returns the shorter read', async () => {
+    const f = fakeFetch(() => new Response(bytes(7, 8), { status: 206, headers: { 'Content-Range': 'bytes 98-99/100' } }));
+    assert.deepEqual(await readRange('skrec://r1/cam0.mkv', 98, 10, f.impl), { bytes: bytes(7, 8), totalSize: 100 });
+});
+
+test('206 that starts somewhere else is an error', async () => {
+    const f = fakeFetch(() => new Response(bytes(1), { status: 206, headers: { 'Content-Range': 'bytes 0-0/100' } }));
+    await assert.rejects(readRange('skrec://r1/cam0.mkv', 10, 1, f.impl), /Content-Range/);
+});
+
+test('206 without Content-Range is an error', async () => {
+    const f = fakeFetch(() => new Response(bytes(1), { status: 206 }));
+    await assert.rejects(readRange('skrec://r1/cam0.mkv', 10, 1, f.impl), /Content-Range/);
+});
+
+test('416 (past EOF) is an empty read with the size', async () => {
+    const f = fakeFetch(() => new Response(null, { status: 416, headers: { 'Content-Range': 'bytes */100' } }));
+    assert.deepEqual(await readRange('skrec://r1/cam0.mkv', 500, 10, f.impl), { bytes: bytes(), totalSize: 100 });
+});
+
+test('file:// 200 carries the ranged bytes but no size; the read is capped', async () => {
+    const f = fakeFetch(() => new Response(bytes(4, 5, 6, 7), { status: 200 }));
+    assert.deepEqual(await readRange('file:///C:/rec/cam0.mkv', 4, 3, f.impl), { bytes: bytes(4, 5, 6), totalSize: null });
+});
+
+test('file:// fetch that throws past EOF is an empty read', async () => {
+    const f = fakeFetch(() => { throw new TypeError('Failed to fetch'); });
+    assert.deepEqual(await readRange('file:///C:/rec/cam0.mkv', 500, 10, f.impl), { bytes: bytes(), totalSize: null });
+});
+
+test('a throw on any other transport is a real error', async () => {
+    const f = fakeFetch(() => { throw new TypeError('Failed to fetch'); });
+    await assert.rejects(readRange('skrec://r1/cam0.mkv', 0, 10, f.impl), /Failed to fetch/);
+});
+
+test('HTTP 200 means the server ignored Range: slice the whole body', async () => {
+    const f = fakeFetch(() => new Response(bytes(0, 1, 2, 3, 4, 5), { status: 200 }));
+    assert.deepEqual(await readRange('http://localhost:53117/x.mkv', 2, 3, f.impl), { bytes: bytes(2, 3, 4), totalSize: 6 });
+});
+
+test('other statuses are errors', async () => {
+    const f = fakeFetch(() => new Response(null, { status: 404 }));
+    await assert.rejects(readRange('skrec://r1/gone.mkv', 0, 10, f.impl), /404/);
+});
+
+test('a zero-length read makes no request', async () => {
+    const f = fakeFetch(() => { throw new Error('should not fetch'); });
+    assert.deepEqual(await readRange('skrec://r1/cam0.mkv', 0, 0, f.impl), { bytes: bytes(), totalSize: null });
+    assert.equal(f.calls.length, 0);
+});
diff --git a/skellycam-ui/tests/recording-grants.test.ts b/skellycam-ui/tests/recording-grants.test.ts
new file mode 100644
index 000000000..de91822b8
--- /dev/null
+++ b/skellycam-ui/tests/recording-grants.test.ts
@@ -0,0 +1,133 @@
+import { test, beforeEach, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { RecordingGrants } from '../electron/main/playback/recording-grants.ts';
+
+let root: string;
+let recording: string;
+let grants: RecordingGrants;
+
+function write(relativePath: string, content = 'x') {
+    const p = path.join(recording, relativePath);
+    fs.mkdirSync(path.dirname(p), { recursive: true });
+    fs.writeFileSync(p, content);
+}
+
+beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), 'skrec-grants-'));
+    recording = path.join(root, '2026-11-12_14-03-00');
+    write('cam0.mkv', 'mkv-bytes');
+    write('cam0.skfr');
+    write('2026-11-12_14-03-00.audio.mka');
+    write('2026-11-12_14-03-00.audio.skau');
+    write('synchronized_videos/cam1.mp4');
+    write('notes.txt');                  // not media
+    write('recording_info.json');        // not media
+    write('.cam9.mkv');                  // hidden
+    write('cam0.web.mp4');               // old transcode copy, not a recording file
+    write('some_subfolder/cam5.mkv');    // only synchronized_videos/ is searched
+    fs.writeFileSync(path.join(root, 'outside.mkv'), 'outside');
+    grants = new RecordingGrants();
+});
+
+afterEach(async () => {
+    await grants.closeAll();
+    fs.rmSync(root, { recursive: true, force: true });
+});
+
+test('open lists only the recording\'s media files, with sizes', async () => {
+    const grant = await grants.open(recording);
+    assert.match(grant.id, /^r\d+$/);
+    assert.deepEqual(grant.files.map(f => f.name).sort(), [
+        '2026-11-12_14-03-00.audio.mka',
+        '2026-11-12_14-03-00.audio.skau',
+        'cam0.mkv',
+        'cam0.skfr',
+        'synchronized_videos/cam1.mp4',
+    ]);
+    assert.equal(grant.files.find(f => f.name === 'cam0.mkv')?.size, 'mkv-bytes'.length);
+});
+
+test('lookup gives a readable handle for a listed file', async () => {
+    const { id } = await grants.open(recording);
+    const file = await grants.lookup(id, 'cam0.mkv');
+    assert.ok(file);
+    assert.equal(file.contentType, 'video/x-matroska');
+    const buf = Buffer.alloc(3);
+    await file.handle.read(buf, 0, 3, 4);
+    assert.equal(buf.toString(), 'byt');
+});
+
+test('lookup serves the legacy synchronized_videos/ subfolder', async () => {
+    const { id } = await grants.open(recording);
+    assert.ok(await grants.lookup(id, 'synchronized_videos/cam1.mp4'));
+});
+
+for (const name of [
+    'notes.txt', 'recording_info.json', '.cam9.mkv', 'cam0.web.mp4', 'some_subfolder/cam5.mkv',
+    '../outside.mkv', '..\\outside.mkv', 'synchronized_videos/../cam0.mkv', '', 'CAM0.MKV',
+]) {
+    test(`lookup refuses ${JSON.stringify(name)}`, async () => {
+        const { id } = await grants.open(recording);
+        assert.equal(await grants.lookup(id, name), null);
+    });
+}
+
+test('lookup refuses an id that was never opened', async () => {
+    await grants.open(recording);
+    assert.equal(await grants.lookup('r999', 'cam0.mkv'), null);
+});
+
+test('close ends the grant', async () => {
+    const { id } = await grants.open(recording);
+    assert.ok(await grants.lookup(id, 'cam0.mkv'));
+    await grants.close(id);
+    assert.equal(await grants.lookup(id, 'cam0.mkv'), null);
+});
+
+test('closeAll ends every grant', async () => {
+    const a = await grants.open(recording);
+    const other = path.join(root, 'second');
+    fs.mkdirSync(other);
+    fs.writeFileSync(path.join(other, 'cam0.mkv'), 'x');
+    const b = await grants.open(other);
+    await grants.closeAll();
+    assert.equal(await grants.lookup(a.id, 'cam0.mkv'), null);
+    assert.equal(await grants.lookup(b.id, 'cam0.mkv'), null);
+});
+
+test('opening the same recording again keeps its id and refreshes the file list', async () => {
+    const first = await grants.open(recording);
+    write('cam1.mkv');
+    const second = await grants.open(recording + path.sep);
+    assert.equal(second.id, first.id);
+    assert.ok(second.files.some(f => f.name === 'cam1.mkv'));
+    assert.ok(await grants.lookup(second.id, 'cam1.mkv'));
+});
+
+test('a closed and reopened recording gets a new id, so stale URLs stop working', async () => {
+    const first = await grants.open(recording);
+    await grants.close(first.id);
+    const second = await grants.open(recording);
+    assert.notEqual(second.id, first.id);
+    assert.equal(await grants.lookup(first.id, 'cam0.mkv'), null);
+});
+
+test('open rejects a missing folder', async () => {
+    await assert.rejects(grants.open(path.join(root, 'nope')));
+});
+
+test('open rejects a folder with no media files', async () => {
+    const empty = path.join(root, 'empty');
+    fs.mkdirSync(empty);
+    fs.writeFileSync(path.join(empty, 'notes.txt'), 'x');
+    await assert.rejects(grants.open(empty), /no media files/i);
+});
+
+test('a file removed after open is refused rather than erroring', async () => {
+    const { id } = await grants.open(recording);
+    fs.rmSync(path.join(recording, 'cam0.skfr'));
+    assert.equal(await grants.lookup(id, 'cam0.skfr'), null);
+});
diff --git a/skellycam-ui/tests/recording-protocol.test.ts b/skellycam-ui/tests/recording-protocol.test.ts
new file mode 100644
index 000000000..10a62ae65
--- /dev/null
+++ b/skellycam-ui/tests/recording-protocol.test.ts
@@ -0,0 +1,150 @@
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { RecordingGrants } from '../electron/main/playback/recording-grants.ts';
+import { createRecordingProtocolHandler, RECORDING_SCHEME } from '../electron/main/playback/recording-protocol.ts';
+
+let root: string;
+let grants: RecordingGrants;
+let handle: (req: Request) => Promise<Response>;
+let id: string;
+const small = crypto.randomBytes(64 * 1024);
+const large = crypto.randomBytes(9 * 1024 * 1024);   // above the single-read limit, so it streams
+
+before(async () => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), 'skrec-protocol-'));
+    fs.writeFileSync(path.join(root, 'cam0.mkv'), small);
+    fs.writeFileSync(path.join(root, 'cam 1.mkv'), small);
+    fs.writeFileSync(path.join(root, 'big.mkv'), large);
+    fs.writeFileSync(path.join(root, 'growing.audio.flac'), small);
+    fs.writeFileSync(path.join(root, 'notes.txt'), 'not media');
+    grants = new RecordingGrants();
+    handle = createRecordingProtocolHandler(grants);
+    ({ id } = await grants.open(root));
+});
+
+after(async () => {
+    await grants.closeAll();
+    fs.rmSync(root, { recursive: true, force: true });
+});
+
+function get(name: string, init: RequestInit & { range?: string } = {}) {
+    const headers = new Headers(init.headers);
+    if (init.range) headers.set('range', init.range);
+    return handle(new Request(`${RECORDING_SCHEME}://${id}/${name}`, { ...init, headers }));
+}
+
+async function body(res: Response) {
+    return Buffer.from(await res.arrayBuffer());
+}
+
+test('single range: 206 with exact bytes and headers', async () => {
+    const res = await get('cam0.mkv', { range: 'bytes=100-199' });
+    assert.equal(res.status, 206);
+    assert.equal(res.headers.get('content-range'), `bytes 100-199/${small.length}`);
+    assert.equal(res.headers.get('content-length'), '100');
+    assert.equal(res.headers.get('accept-ranges'), 'bytes');
+    assert.equal(res.headers.get('content-type'), 'video/x-matroska');
+    assert.equal(res.headers.get('cache-control'), 'no-store');
+    assert.equal(res.headers.get('access-control-allow-origin'), '*');
+    assert.equal(res.headers.get('access-control-expose-headers'), 'Content-Range, Content-Length, Accept-Ranges');
+    assert.deepEqual(await body(res), small.subarray(100, 200));
+});
+
+test('suffix and open-ended ranges', async () => {
+    const suffix = await get('cam0.mkv', { range: 'bytes=-16' });
+    assert.equal(suffix.status, 206);
+    assert.deepEqual(await body(suffix), small.subarray(small.length - 16));
+
+    const open = await get('cam0.mkv', { range: `bytes=${small.length - 10}-` });
+    assert.equal(open.headers.get('content-range'), `bytes ${small.length - 10}-${small.length - 1}/${small.length}`);
+    assert.deepEqual(await body(open), small.subarray(small.length - 10));
+});
+
+test('no Range: 200 with the whole file and its length', async () => {
+    const res = await get('cam0.mkv');
+    assert.equal(res.status, 200);
+    assert.equal(res.headers.get('content-length'), String(small.length));
+    assert.equal(res.headers.get('content-range'), null);
+    assert.deepEqual(await body(res), small);
+});
+
+test('large ranges stream the exact bytes', async () => {
+    const start = 123;
+    const end = large.length - 7;
+    const res = await get('big.mkv', { range: `bytes=${start}-${end}` });
+    assert.equal(res.status, 206);
+    assert.equal(res.headers.get('content-length'), String(end - start + 1));
+    assert.deepEqual(await body(res), large.subarray(start, end + 1));
+});
+
+test('HEAD gives the headers without a body', async () => {
+    const whole = await get('cam0.mkv', { method: 'HEAD' });
+    assert.equal(whole.status, 200);
+    assert.equal(whole.headers.get('content-length'), String(small.length));
+    assert.equal((await body(whole)).length, 0);
+
+    const part = await get('cam0.mkv', { method: 'HEAD', range: 'bytes=0-9' });
+    assert.equal(part.status, 206);
+    assert.equal(part.headers.get('content-range'), `bytes 0-9/${small.length}`);
+    assert.equal((await body(part)).length, 0);
+});
+
+for (const range of [`bytes=${64 * 1024}-`, 'bytes=-0', 'bytes=0-1,5-9', 'bytes=junk']) {
+    test(`416 with the size for ${range}`, async () => {
+        const res = await get('cam0.mkv', { range });
+        assert.equal(res.status, 416);
+        assert.equal(res.headers.get('content-range'), `bytes */${small.length}`);
+        assert.equal(res.headers.get('cache-control'), 'no-store');
+    });
+}
+
+test('percent-encoded names are decoded', async () => {
+    const res = await get('cam%201.mkv', { range: 'bytes=0-3' });
+    assert.equal(res.status, 206);
+    assert.deepEqual(await body(res), small.subarray(0, 4));
+});
+
+for (const name of ['notes.txt', 'nope.mkv', '..%2Fcam0.mkv', '%E0%A4%A']) {
+    test(`404 for ${name}`, async () => {
+        assert.equal((await get(name)).status, 404);
+    });
+}
+
+test('404 for an unknown grant id', async () => {
+    const res = await handle(new Request(`${RECORDING_SCHEME}://r999/cam0.mkv`));
+    assert.equal(res.status, 404);
+});
+
+test('405 for methods other than GET and HEAD', async () => {
+    const res = await get('cam0.mkv', { method: 'POST' });
+    assert.equal(res.status, 405);
+    assert.equal(res.headers.get('allow'), 'GET, HEAD');
+});
+
+test('the size is read on every request, so a file that grows is served in full', async () => {
+    const extra = crypto.randomBytes(500);
+    fs.appendFileSync(path.join(root, 'growing.audio.flac'), extra);
+    const res = await get('growing.audio.flac', { range: `bytes=${small.length}-` });
+    assert.equal(res.status, 206);
+    assert.equal(res.headers.get('content-range'), `bytes ${small.length}-${small.length + 499}/${small.length + 500}`);
+    assert.deepEqual(await body(res), extra);
+});
+
+test('64 concurrent reads all return the right bytes', async () => {
+    const offsets = Array.from({ length: 64 }, () => Math.floor(Math.random() * (large.length - 150_000)));
+    const results = await Promise.all(offsets.map(o => get('big.mkv', { range: `bytes=${o}-${o + 149_999}` }).then(body)));
+    results.forEach((buf, i) => assert.ok(buf.equals(large.subarray(offsets[i], offsets[i] + 150_000)), `read ${i}`));
+});
+
+test('a closed grant is 404', async () => {
+    const other = new RecordingGrants();
+    const h = createRecordingProtocolHandler(other);
+    const g = await other.open(root);
+    assert.equal((await h(new Request(`${RECORDING_SCHEME}://${g.id}/cam0.mkv`, { headers: { range: 'bytes=0-0' } }))).status, 206);
+    await other.close(g.id);
+    assert.equal((await h(new Request(`${RECORDING_SCHEME}://${g.id}/cam0.mkv`))).status, 404);
+});

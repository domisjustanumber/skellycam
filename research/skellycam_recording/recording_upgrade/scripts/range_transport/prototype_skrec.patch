index 000000000..cd3a8c76d
--- /dev/null
+++ b/skellycam-ui/src/services/playback/range-reader.ts
@@ -0,0 +1,66 @@
+/**
+ * Byte-range reads for the recording player and the sidecar locator (T-S5 FINDINGS §7).
+ *
+ * Works on every transport the player may be given:
+ * - skrec:// (the Electron protocol) and the HTTP fallback: 206 + Content-Range, 416 past EOF;
+ * - file:// (last resort): 200 with the ranged bytes and no size; a read past EOF throws.
+ *
+ * A read past EOF returns empty bytes rather than throwing, so the locator can report it.
+ */
+
+export interface RangeRead {
+    bytes: Uint8Array;
+    /** Total file size when the transport reports it (206 or 416), else null. */
+    totalSize: number | null;
+}
+
+const CONTENT_RANGE = /^bytes (\d+)-(\d+)\/(\d+|\*)$/;
+const UNSATISFIED_RANGE = /^bytes \*\/(\d+)$/;
+
+const EMPTY = new Uint8Array(0);
+
+export async function readRange(
+    url: string,
+    offset: number,
+    length: number,
+    fetchImpl: typeof fetch = fetch,
+): Promise<RangeRead> {
+    if (length <= 0) return { bytes: EMPTY, totalSize: null };
+    const isFile = url.startsWith('file:');
+
+    let response: Response;
+    try {
+        response = await fetchImpl(url, {
+            headers: { Range: `bytes=${offset}-${offset + length - 1}` },
+            // Chromium's HTTP cache fails some concurrent ranges to one URL (T-S5 §3).
+            cache: 'no-store',
+        });
+    } catch (error) {
+        if (isFile) return { bytes: EMPTY, totalSize: null };   // file:// throws for a range past EOF
+        throw error;
+    }
+
+    if (response.status === 416) {
+        const m = UNSATISFIED_RANGE.exec(response.headers.get('Content-Range') ?? '');
+        return { bytes: EMPTY, totalSize: m ? Number(m[1]) : null };
+    }
+
+    if (response.status === 206) {
+        const header = response.headers.get('Content-Range') ?? '';
+        const m = CONTENT_RANGE.exec(header);
+        if (!m || Number(m[1]) !== offset) {
+            throw new Error(`${url}: asked for bytes from ${offset}, got Content-Range "${header}"`);
+        }
+        const bytes = new Uint8Array(await response.arrayBuffer());
+        return { bytes: bytes.subarray(0, length), totalSize: m[3] === '*' ? null : Number(m[3]) };
+    }
+
+    if (response.status === 200) {
+        const body = new Uint8Array(await response.arrayBuffer());
+        if (isFile) return { bytes: body.subarray(0, length), totalSize: null };
+        // An HTTP server that ignored Range sent the whole file.
+        return { bytes: body.subarray(offset, offset + length), totalSize: body.length };
+    }
+
+    throw new Error(`${url}: HTTP ${response.status} for bytes from ${offset}`);
+}
diff --git a/skellycam-ui/tests/byte-range.test.ts b/skellycam-ui/tests/byte-range.test.ts
new file mode 100644
index 000000000..1fb470120
--- /dev/null
+++ b/skellycam-ui/tests/byte-range.test.ts
@@ -0,0 +1,61 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { parseRangeHeader } from '../electron/main/playback/byte-range.ts';
+
+const SIZE = 1000;
+
+test('no Range header asks for the whole file', () => {
+    assert.deepEqual(parseRangeHeader(null, SIZE), { kind: 'whole' });
+});
+
+test('explicit range', () => {
+    assert.deepEqual(parseRangeHeader('bytes=10-19', SIZE), { kind: 'partial', start: 10, end: 19 });
+});
+
+test('end past EOF is clamped to the last byte', () => {
+    assert.deepEqual(parseRangeHeader('bytes=990-5000', SIZE), { kind: 'partial', start: 990, end: 999 });
+});
+
+test('open-ended range runs to EOF', () => {
+    assert.deepEqual(parseRangeHeader('bytes=500-', SIZE), { kind: 'partial', start: 500, end: 999 });
+});
+
+test('suffix range takes the last n bytes', () => {
+    assert.deepEqual(parseRangeHeader('bytes=-100', SIZE), { kind: 'partial', start: 900, end: 999 });
+});
+
+test('suffix longer than the file gives the whole file', () => {
+    assert.deepEqual(parseRangeHeader('bytes=-5000', SIZE), { kind: 'partial', start: 0, end: 999 });
+});
+
+test('ranges past 4 GiB keep exact offsets', () => {
+    const big = 4_685_500_000;
+    assert.deepEqual(parseRangeHeader('bytes=4685429234-4685429333', big),
+        { kind: 'partial', start: 4_685_429_234, end: 4_685_429_333 });
+});
+
+test('the unit name is case-insensitive and whitespace around the value is ignored', () => {
+    assert.deepEqual(parseRangeHeader('  Bytes=0-0 ', SIZE), { kind: 'partial', start: 0, end: 0 });
+});
+
+for (const header of [
+    'bytes=1000-',       // start at EOF
+    'bytes=5000-6000',   // start past EOF
+    'bytes=-0',          // empty suffix
+    'bytes=10-5',        // end before start
+    'bytes=0-1,5-9',     // multi-range: the player never sends it
+    'bytes=-',
+    'items=0-5',
+    'bytes=abc',
+    'bytes=99999999999999999999-',  // beyond Number precision
+]) {
+    test(`unsatisfiable: ${header}`, () => {
+        assert.deepEqual(parseRangeHeader(header, SIZE), { kind: 'unsatisfiable' });
+    });
+}
+
+test('every range of an empty file is unsatisfiable, but a whole read is fine', () => {
+    assert.deepEqual(parseRangeHeader('bytes=0-', 0), { kind: 'unsatisfiable' });
+    assert.deepEqual(parseRangeHeader('bytes=-5', 0), { kind: 'unsatisfiable' });
+    assert.deepEqual(parseRangeHeader(null, 0), { kind: 'whole' });
+});

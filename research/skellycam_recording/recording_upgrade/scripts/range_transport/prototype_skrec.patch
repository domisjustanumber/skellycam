@@ -0,0 +1,32 @@
+/**
+ * Wires the recording protocol into Electron.
+ *
+ * - `registerRecordingSchemePrivileges()` must run before the app is ready.
+ * - `handleRecordingScheme()` runs after ready. It also closes every grant
+ *   whenever a page loads or reloads, so a reloaded page doesn't leave file handles open.
+ */
+import { app, protocol } from 'electron';
+import { RecordingGrants } from './recording-grants.ts';
+import { createRecordingProtocolHandler, RECORDING_SCHEME } from './recording-protocol.ts';
+
+export const recordingGrants = new RecordingGrants();
+
+export function registerRecordingSchemePrivileges(): void {
+    protocol.registerSchemesAsPrivileged([{
+        scheme: RECORDING_SCHEME,
+        // The set measured in T-S5 (E35 and E45). `stream` lets <video> read it for old recordings.
+        privileges: { standard: true, secure: true, supportFetchAPI: true, stream: true, corsEnabled: true },
+    }]);
+}
+
+export function handleRecordingScheme(): void {
+    protocol.handle(RECORDING_SCHEME, createRecordingProtocolHandler(recordingGrants));
+
+    app.on('web-contents-created', (_event, contents) => {
+        contents.on('did-start-navigation', (details) => {
+            if (details.isMainFrame && !details.isSameDocument) {
+                void recordingGrants.closeAll();
+            }
+        });
+    });
+}

+++ b/freemocap/core/tasks/calibration/charuco_board/board_motion.py
@@ -0,0 +1,334 @@
+"""Charuco board stillness: only calibrate from frames where the board is held still.
+
+freemocap's USB webcams are rolling-shutter: image rows are read out over ~30 ms
+of a ~33 ms frame. A moving board is therefore sheared within one image, and
+because it sits at different image heights in different cameras, each camera
+captures it at a different instant. Both calibration solvers assume ONE rigid
+board pose per frame index, shared by every camera, so moving-board frames add
+systematic error that robust losses can only down-weight. Motion blur also
+degrades corner accuracy.
+
+Metric (per camera, per frame): the MEDIAN pixel displacement of the charuco
+corners seen in both this frame and the reference (previous usable) frame,
+divided by the frame-number gap. Same median-over-shared-corners idea as
+``groundplane_math.find_stable_window``, but in 2D image space because no
+calibration exists yet.
+
+Units are px per camera frame, not px/s: rolling-shutter shear and motion blur
+both scale with how far the board moves *during one frame*, and frame numbers
+are available in realtime (connection frame number) and posthoc (recording
+frame index) with no extra plumbing.
+
+No IO. The realtime CameraNode (overlay colour) and the posthoc calibration
+task (frame filter) both use ``BoardStillnessTracker`` so they behave the same.
+"""
+import logging
+from dataclasses import dataclass, field, replace
+
+import numpy as np
+from numpy.typing import NDArray
+from pydantic import BaseModel, ConfigDict, model_validator
+from skellycam.core.types.type_overloads import CameraIdString
+from skellytracker.core.data_primitives.keypoints import Keypoints
+from skellytracker.core.data_primitives.observation import Observation
+
+logger = logging.getLogger(__name__)
+
+CHARUCO_STAGE_NAME = "charuco"
+_CHARUCO_CORNER_PREFIX = "CharucoCorner-"
+
+# corner_id -> (2,) pixel xy
+CornerPixels = dict[int, NDArray[np.float64]]
+
+
+class CharucoStillnessError(RuntimeError):
+    """Raised when too few still-board frames remain to calibrate a camera."""
+
+
+class BoardStillnessConfig(BaseModel):
+    """Thresholds for deciding when the charuco board is held still."""
+
+    model_config = ConfigDict(extra="forbid", frozen=True)
+
+    # Realtime: False keeps the legacy always-green overlay.
+    # Posthoc: False feeds every detected frame to the solver (old behaviour).
+    enabled: bool = True
+    # A frame-to-frame transition counts as still when the median shared-corner
+    # displacement is at or below this (px per camera frame).
+    max_motion_px_per_frame: float = 1.0
+    # Hysteresis: this many consecutive still transitions before the board is
+    # reported still. Still -> moving is immediate.
+    min_still_transitions: int = 3
+    # Fewer corners than this (in the frame, or shared with the reference) means
+    # motion is unknown and the frame is not still. Also the bar for a camera to
+    # "see the board" in the multi-camera rule.
+    min_shared_corners: int = 4
+    # A frame-number gap larger than this (dropped realtime frames, board out of
+    # view) discards the reference, so the next frame cannot be still.
+    max_frame_gap: int = 3
+    # Posthoc only: fail if a camera that saw the board keeps fewer still frames.
+    min_still_frames_per_camera: int = 10
+
+    @model_validator(mode="after")
+    def validate_values(self) -> "BoardStillnessConfig":
+        if self.max_motion_px_per_frame <= 0.0:
+            raise ValueError(f"max_motion_px_per_frame must be > 0, got {self.max_motion_px_per_frame}")
+        if self.min_still_transitions < 1:
+            raise ValueError(f"min_still_transitions must be >= 1, got {self.min_still_transitions}")
+        if self.min_shared_corners < 1:
+            raise ValueError(f"min_shared_corners must be >= 1, got {self.min_shared_corners}")
+        if self.max_frame_gap < 1:
+            raise ValueError(f"max_frame_gap must be >= 1, got {self.max_frame_gap}")
+        return self
+
+
+@dataclass(frozen=True, slots=True)
+class BoardMotionSample:
+    """Board motion for one camera at one frame."""
+
+    frame_number: int
+    n_corners: int
+    # None = no usable reference (first sighting, gap, too few shared corners).
+    motion_px_per_frame: float | None
+    is_still: bool
+
+
+def charuco_corner_pixels(observation: Observation | None) -> CornerPixels:
+    """Visible charuco corners of one observation as {corner_id: (2,) xy}.
+
+    Same visibility rule as posthoc_calibration_task._observation_to_frame_observation:
+    zero-visibility or NaN points are skipped. ArUco marker corners are ignored.
+    """
+    if observation is None:
+        return {}
+    stage = observation.stages.get(CHARUCO_STAGE_NAME)
+    if stage is None or stage.keypoints is None:
+        return {}
+
+    kpts = stage.keypoints
+    corners: CornerPixels = {}
+    for idx, name in enumerate(kpts.names):
+        if not name.startswith(_CHARUCO_CORNER_PREFIX):
+            continue
+        if kpts.visibility[idx] <= 0.0 or np.isnan(kpts.xyz[idx, :2]).any():
+            continue
+        corners[int(name[len(_CHARUCO_CORNER_PREFIX):])] = np.array(kpts.xyz[idx, :2], dtype=np.float64)
+    return corners
+
+
+def board_motion_px_per_frame(
+        *,
+        previous_corners: CornerPixels,
+        current_corners: CornerPixels,
+        frame_gap: int,
+        min_shared_corners: int,
+) -> float | None:
+    """Median displacement of shared corners, per camera frame. None if not measurable."""
+    if frame_gap < 1:
+        return None
+    shared_ids = sorted(previous_corners.keys() & current_corners.keys())
+    if len(shared_ids) < min_shared_corners:
+        return None
+    previous_xy = np.stack([previous_corners[corner_id] for corner_id in shared_ids])
+    current_xy = np.stack([current_corners[corner_id] for corner_id in shared_ids])
+    displacement = np.linalg.norm(current_xy - previous_xy, axis=1)
+    return float(np.median(displacement)) / frame_gap
+
+
+@dataclass
+class BoardStillnessTracker:
+    """Per-camera stillness state with hysteresis. Feed frames in frame-number order."""
+
+    config: BoardStillnessConfig
+    _reference_corners: CornerPixels = field(default_factory=dict, repr=False)
+    _reference_frame_number: int | None = field(default=None, repr=False)
+    _still_transitions: int = field(default=0, repr=False)
+
+    def reset(self) -> None:
+        self._reference_corners = {}
+        self._reference_frame_number = None
+        self._still_transitions = 0
+
+    def update(self, *, frame_number: int, corners: CornerPixels) -> BoardMotionSample:
+        if len(corners) < self.config.min_shared_corners:
+            # Too little board to judge. Keep the reference and the still run, so a
+            # one-frame detection dropout doesn't restart the hysteresis; the gap
+            # check below still discards a stale reference.
+            return BoardMotionSample(
+                frame_number=frame_number,
+                n_corners=len(corners),
+                motion_px_per_frame=None,
+                is_still=False,
+            )
+
+        motion: float | None = None
+        if self._reference_frame_number is not None:
+            frame_gap = frame_number - self._reference_frame_number
+            if 1 <= frame_gap <= self.config.max_frame_gap:
+                motion = board_motion_px_per_frame(
+                    previous_corners=self._reference_corners,
+                    current_corners=corners,
+                    frame_gap=frame_gap,
+                    min_shared_corners=self.config.min_shared_corners,
+                )
+
+        if motion is not None and motion <= self.config.max_motion_px_per_frame:
+            self._still_transitions += 1
+        else:
+            self._still_transitions = 0
+
+        self._reference_corners = corners
+        self._reference_frame_number = frame_number
+        return BoardMotionSample(
+            frame_number=frame_number,
+            n_corners=len(corners),
+            motion_px_per_frame=motion,
+            is_still=self._still_transitions >= self.config.min_still_transitions,
+        )
+
+
+# =============================================================================
+# POSTHOC: MULTI-CAMERA STILL-FRAME FILTER
+# =============================================================================
+
+
+@dataclass(frozen=True)
+class StillFrameFilterReport:
+    n_frames: int
+    n_frames_kept: int
+    frames_with_board_by_camera: dict[CameraIdString, int]
+    still_frames_by_camera: dict[CameraIdString, int]
+
+    @property
+    def summary(self) -> str:
+        per_camera = ", ".join(
+            f"{camera_id}: {self.still_frames_by_camera[camera_id]}/{n_with_board}"
+            for camera_id, n_with_board in self.frames_with_board_by_camera.items()
+        )
+        return (
+            f"Charuco still-frame filter kept {self.n_frames_kept}/{self.n_frames} frames "
+            f"(still/with-board per camera — {per_camera})"
+        )
+
+
+def compute_board_motion_by_camera(
+        *,
+        charuco_observations_by_frame: list[dict[CameraIdString, Observation]],
+        config: BoardStillnessConfig,
+) -> dict[CameraIdString, list[BoardMotionSample]]:
+    """Run one BoardStillnessTracker per camera over a posthoc recording.
+
+    Uses the list index as the frame number: posthoc frames are contiguous
+    recording frames, the same index _convert_all_observations stamps.
+    """
+    if not charuco_observations_by_frame:
+        return {}
+    camera_ids = list(charuco_observations_by_frame[0].keys())
+    trackers = {camera_id: BoardStillnessTracker(config=config) for camera_id in camera_ids}
+    samples: dict[CameraIdString, list[BoardMotionSample]] = {camera_id: [] for camera_id in camera_ids}
+    for frame_index, observations_by_camera in enumerate(charuco_observations_by_frame):
+        for camera_id, tracker in trackers.items():
+            samples[camera_id].append(
+                tracker.update(
+                    frame_number=frame_index,
+                    corners=charuco_corner_pixels(observations_by_camera.get(camera_id)),
+                )
+            )
+    return samples
+
+
+def still_frame_mask(
+        *,
+        motion_by_camera: dict[CameraIdString, list[BoardMotionSample]],
+        config: BoardStillnessConfig,
+) -> NDArray[np.bool_]:
+    """Keep a frame only if every camera that saw the board reports it still.
+
+    Board motion is physical, so one camera seeing it move is enough to drop
+    the frame for all cameras. Cameras with fewer than min_shared_corners don't
+    vote. A frame no camera saw well is dropped (nothing to calibrate from).
+    """
+    if not motion_by_camera:
+        return np.zeros(0, dtype=bool)
+    n_frames = len(next(iter(motion_by_camera.values())))
+    keep = np.zeros(n_frames, dtype=bool)
+    for frame_index in range(n_frames):
+        voters = [
+            samples[frame_index]
+            for samples in motion_by_camera.values()
+            if samples[frame_index].n_corners >= config.min_shared_corners
+        ]
+        keep[frame_index] = bool(voters) and all(sample.is_still for sample in voters)
+    return keep
+
+
+def _without_charuco_corners(observation: Observation) -> Observation:
+    """Same observation with every charuco-stage point blanked (NaN, visibility 0).
+
+    The charuco stage itself stays, so downstream validation and anipose row
+    building see an ordinary "board not detected" frame.
+    """
+    stage = observation.stages.get(CHARUCO_STAGE_NAME)
+    if stage is None or stage.keypoints is None:
+        return observation
+    blank_stage = replace(stage, keypoints=Keypoints.empty(stage.keypoints.names))
+    return replace(observation, stages={**observation.stages, CHARUCO_STAGE_NAME: blank_stage})
+
+
+def filter_moving_charuco_frames(
+        *,
+        charuco_observations_by_frame: list[dict[CameraIdString, Observation]],
+        config: BoardStillnessConfig,
+) -> tuple[list[dict[CameraIdString, Observation]], StillFrameFilterReport]:
+    """Blank charuco corners on every frame where the board was moving.
+
+    Returns a new list the same length as the input (frame indices stay aligned);
+    the input observations are not mutated.
+
+    Raises:
+        CharucoStillnessError: if a camera that saw the board keeps fewer than
+            config.min_still_frames_per_camera still frames.
+    """
+    motion_by_camera = compute_board_motion_by_camera(
+        charuco_observations_by_frame=charuco_observations_by_frame,
+        config=config,
+    )
+    keep = still_frame_mask(motion_by_camera=motion_by_camera, config=config)
+
+    filtered: list[dict[CameraIdString, Observation]] = [
+        observations_by_camera
+        if keep[frame_index]
+        else {camera_id: _without_charuco_corners(obs) for camera_id, obs in observations_by_camera.items()}
+        for frame_index, observations_by_camera in enumerate(charuco_observations_by_frame)
+    ]
+
+    frames_with_board_by_camera: dict[CameraIdString, int] = {}
+    still_frames_by_camera: dict[CameraIdString, int] = {}
+    for camera_id, samples in motion_by_camera.items():
+        with_board = np.array([sample.n_corners >= config.min_shared_corners for sample in samples], dtype=bool)
+        frames_with_board_by_camera[camera_id] = int(with_board.sum())
+        still_frames_by_camera[camera_id] = int((with_board & keep).sum())
+
+    report = StillFrameFilterReport(
+        n_frames=len(charuco_observations_by_frame),
+        n_frames_kept=int(keep.sum()),
+        frames_with_board_by_camera=frames_with_board_by_camera,
+        still_frames_by_camera=still_frames_by_camera,
+    )
+
+    too_few = {
+        camera_id: n_still
+        for camera_id, n_still in still_frames_by_camera.items()
+        if frames_with_board_by_camera[camera_id] > 0 and n_still < config.min_still_frames_per_camera
+    }
+    if too_few:
+        raise CharucoStillnessError(
+            f"Too few frames with the charuco board held still: {too_few} "
+            f"(need >= {config.min_still_frames_per_camera} per camera). "
+            f"A frame counts as still once the board moves <= {config.max_motion_px_per_frame} px/frame "
+            f"for {config.min_still_transitions} frames in a row in every camera that sees it. "
+            f"Hold the board still for about half a second at each pose, or set "
+            f"board_stillness_config.enabled=False to calibrate from every frame. {report.summary}"
+        )
+
+    return filtered, report
diff --git a/freemocap/tests/calibration/test_board_motion.py b/freemocap/tests/calibration/test_board_motion.py

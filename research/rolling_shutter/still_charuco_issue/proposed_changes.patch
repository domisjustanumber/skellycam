@@ -0,0 +1,215 @@
+"""Unit tests for charuco board stillness (realtime overlay colour + posthoc frame filter)."""
+import numpy as np
+import pytest
+from skellytracker.core.data_primitives.keypoints import Keypoints
+from skellytracker.core.data_primitives.observation import Observation, StageObservation
+from skellytracker.core.detectors.keypoint_detectors.charuco.anipose_export import to_anipose_camera_row
+from skellytracker.core.detectors.keypoint_detectors.charuco import CharucoBoardDefinition
+
+from freemocap.core.tasks.calibration.charuco_board.board_motion import (
+    BoardStillnessConfig,
+    BoardStillnessTracker,
+    CharucoStillnessError,
+    board_motion_px_per_frame,
+    charuco_corner_pixels,
+    compute_board_motion_by_camera,
+    filter_moving_charuco_frames,
+    still_frame_mask,
+)
+
+BOARD = CharucoBoardDefinition(squares_x=5, squares_y=3, square_length_mm=54.0, aruco_dictionary_enum=2)
+N_CORNERS = BOARD.n_corners  # 8 for a 5x3 board
+BASE_XY = np.array([[100.0 + 40.0 * (i % 4), 200.0 + 40.0 * (i // 4)] for i in range(N_CORNERS)])
+
+CONFIG = BoardStillnessConfig(
+    max_motion_px_per_frame=1.0,
+    min_still_transitions=3,
+    min_shared_corners=4,
+    max_frame_gap=3,
+    min_still_frames_per_camera=1,
+)
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+def _corners(offset_xy: tuple[float, float] = (0.0, 0.0), ids: range | list[int] = range(N_CORNERS)) -> dict:
+    return {i: BASE_XY[i] + np.asarray(offset_xy) for i in ids}
+
+
+def _obs(frame_number: int, offset_xy: tuple[float, float] | None = (0.0, 0.0)) -> Observation:
+    """Charuco Observation shaped like CharucoDetector output; offset None = board not detected."""
+    names = tuple(f"CharucoCorner-{i}" for i in range(N_CORNERS)) + ("ArucoMarkerCorner-0-0",)
+    kpts = Keypoints.empty(names)
+    if offset_xy is not None:
+        kpts.xyz[:N_CORNERS, :2] = BASE_XY + np.asarray(offset_xy)
+        kpts.visibility[:N_CORNERS] = 1.0
+    return Observation(
+        frame_number=frame_number,
+        image_size=(720, 1280),
+        stages={"charuco": StageObservation(name="charuco", keypoints=kpts)},
+    )
+
+
+def _run(tracker: BoardStillnessTracker, offsets: list[tuple[float, float] | None]) -> list[bool]:
+    return [
+        tracker.update(
+            frame_number=frame,
+            corners={} if offset is None else _corners(offset),
+        ).is_still
+        for frame, offset in enumerate(offsets)
+    ]
+
+
+# ---------------------------------------------------------------------------
+# Metric
+# ---------------------------------------------------------------------------
+
+def test_charuco_corner_pixels_skips_invisible_and_aruco_points():
+    obs = _obs(0)
+    obs.stages["charuco"].keypoints.visibility[2] = 0.0
+    corners = charuco_corner_pixels(obs)
+    assert sorted(corners) == [i for i in range(N_CORNERS) if i != 2]
+    np.testing.assert_allclose(corners[0], BASE_XY[0])
+    assert charuco_corner_pixels(None) == {}
+    assert charuco_corner_pixels(_obs(0, offset_xy=None)) == {}
+
+
+def test_motion_is_zero_for_identical_corners():
+    assert board_motion_px_per_frame(
+        previous_corners=_corners(), current_corners=_corners(), frame_gap=1, min_shared_corners=4,
+    ) == pytest.approx(0.0)
+
+
+def test_motion_is_normalised_by_frame_gap():
+    assert board_motion_px_per_frame(
+        previous_corners=_corners(), current_corners=_corners((3.0, 4.0)), frame_gap=1, min_shared_corners=4,
+    ) == pytest.approx(5.0)
+    assert board_motion_px_per_frame(
+        previous_corners=_corners(), current_corners=_corners((6.0, 8.0)), frame_gap=2, min_shared_corners=4,
+    ) == pytest.approx(5.0)
+
+
+def test_motion_median_ignores_a_single_bad_corner():
+    current = _corners()
+    current[0] = current[0] + np.array([50.0, 0.0])
+    assert board_motion_px_per_frame(
+        previous_corners=_corners(), current_corners=current, frame_gap=1, min_shared_corners=4,
+    ) == pytest.approx(0.0)
+
+
+def test_motion_unknown_with_too_few_shared_corners():
+    assert board_motion_px_per_frame(
+        previous_corners=_corners(ids=[0, 1, 2, 3]),
+        current_corners=_corners(ids=[2, 3, 4, 5]),
+        frame_gap=1,
+        min_shared_corners=4,
+    ) is None
+
+
+# ---------------------------------------------------------------------------
+# Hysteresis
+# ---------------------------------------------------------------------------
+
+def test_first_frame_is_moving_and_still_needs_n_transitions():
+    tracker = BoardStillnessTracker(config=CONFIG)
+    # frame 0 has no reference; frames 1..3 are the 3 still transitions
+    assert _run(tracker, [(0.0, 0.0)] * 5) == [False, False, False, True, True]
+
+
+def test_moving_is_immediate_then_still_rebuilds():
+    tracker = BoardStillnessTracker(config=CONFIG)
+    offsets = [(0.0, 0.0)] * 4 + [(5.0, 0.0)] + [(5.0, 0.0)] * 3
+    assert _run(tracker, offsets) == [False, False, False, True, False, False, False, True]
+
+
+def test_slow_drift_below_threshold_counts_as_still():
+    tracker = BoardStillnessTracker(config=CONFIG)
+    offsets = [(0.5 * i, 0.0) for i in range(5)]
+    assert _run(tracker, offsets) == [False, False, False, True, True]
+
+
+def test_single_frame_dropout_keeps_the_still_run():
+    tracker = BoardStillnessTracker(config=CONFIG)
+    # dropout frame reports not-still, but the run resumes against the frame-3 reference
+    assert _run(tracker, [(0.0, 0.0)] * 4 + [None] + [(0.0, 0.0)]) == [False, False, False, True, False, True]
+
+
+def test_gap_longer_than_max_frame_gap_resets():
+    tracker = BoardStillnessTracker(config=CONFIG)
+    for frame in range(4):
+        tracker.update(frame_number=frame, corners=_corners())
+    sample = tracker.update(frame_number=3 + CONFIG.max_frame_gap + 1, corners=_corners())
+    assert sample.motion_px_per_frame is None
+    assert sample.is_still is False
+
+
+def test_config_rejects_nonsense():
+    with pytest.raises(ValueError):
+        BoardStillnessConfig(max_motion_px_per_frame=0.0)
+    with pytest.raises(ValueError):
+        BoardStillnessConfig(min_still_transitions=0)
+
+
+# ---------------------------------------------------------------------------
+# Posthoc multi-camera filter
+# ---------------------------------------------------------------------------
+
+def _recording(offsets_by_camera: dict[str, list[tuple[float, float] | None]]) -> list[dict[str, Observation]]:
+    n_frames = len(next(iter(offsets_by_camera.values())))
+    return [
+        {camera_id: _obs(frame, offsets[frame]) for camera_id, offsets in offsets_by_camera.items()}
+        for frame in range(n_frames)
+    ]
+
+
+def test_one_moving_camera_drops_the_frame_for_all_cameras():
+    still = [(0.0, 0.0)] * 6
+    waving = [(0.0, 0.0)] * 4 + [(5.0, 0.0), (5.0, 0.0)]
+    recording = _recording({"cam_a": still, "cam_b": waving})
+    keep = still_frame_mask(
+        motion_by_camera=compute_board_motion_by_camera(charuco_observations_by_frame=recording, config=CONFIG),
+        config=CONFIG,
+    )
+    assert keep.tolist() == [False, False, False, True, False, False]
+
+
+def test_camera_that_cannot_see_the_board_does_not_veto():
+    recording = _recording({"cam_a": [(0.0, 0.0)] * 5, "cam_b": [None] * 5})
+    keep = still_frame_mask(
+        motion_by_camera=compute_board_motion_by_camera(charuco_observations_by_frame=recording, config=CONFIG),
+        config=CONFIG,
+    )
+    assert keep.tolist() == [False, False, False, True, True]
+
+
+def test_filter_blanks_dropped_frames_without_mutating_input():
+    recording = _recording({"cam_a": [(0.0, 0.0)] * 5, "cam_b": [(0.0, 0.0)] * 5})
+    filtered, report = filter_moving_charuco_frames(charuco_observations_by_frame=recording, config=CONFIG)
+
+    assert len(filtered) == len(recording)
+    assert report.n_frames_kept == 2
+    assert report.still_frames_by_camera == {"cam_a": 2, "cam_b": 2}
+    assert report.frames_with_board_by_camera == {"cam_a": 5, "cam_b": 5}
+
+    dropped = filtered[0]["cam_a"]
+    assert "charuco" in dropped.stages  # posthoc validation still passes
+    assert dropped.stages["charuco"].keypoints.names == recording[0]["cam_a"].stages["charuco"].keypoints.names
+    assert charuco_corner_pixels(dropped) == {}
+    assert filtered[4]["cam_a"] is recording[4]["cam_a"]
+    # input untouched
+    assert len(charuco_corner_pixels(recording[0]["cam_a"])) == N_CORNERS
+
+    # anipose sees a dropped frame as an ordinary no-detection row
+    row = to_anipose_camera_row(
+        keypoints=dropped.stages["charuco"].keypoints, board_def=BOARD, frame_number=0,
+    )
+    assert np.isnan(row["filled"]).all()
+
+
+def test_filter_raises_when_too_few_still_frames():
+    config = CONFIG.model_copy(update={"min_still_frames_per_camera": 10})
+    recording = _recording({"cam_a": [(5.0 * i, 0.0) for i in range(20)]})
+    with pytest.raises(CharucoStillnessError, match="Hold the board still"):
+        filter_moving_charuco_frames(charuco_observations_by_frame=recording, config=config)

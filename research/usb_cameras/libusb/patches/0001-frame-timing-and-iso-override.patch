+  /** SCR source time clock / 11-bit SOF of the LAST payload header that carried an SCR */
+  uint32_t scr_stc_last;
+  uint16_t scr_sof_last;
+  uint8_t has_pts;
+  uint8_t has_scr;
+  /** 1 if the frame was closed by the EOF bit, 0 if by an FID toggle or a full buffer */
+  uint8_t closed_by_eof;
+  /** FID bit of this frame */
+  uint8_t fid;
+  /** host time of the transfer completion that carried the first data payload of this frame */
+  int64_t host_first_payload_ns;
+  /** host time of the transfer completion that carried the payload that closed this frame */
+  int64_t host_last_payload_ns;
+  /** iso packet index (within its transfer) of the first / last payload, -1 for bulk */
+  int32_t first_payload_packet_idx;
+  int32_t last_payload_packet_idx;
+  /** iso packets per transfer used by this stream (0 for bulk) */
+  int32_t packets_per_transfer;
+  /** number of non-empty payloads that made up this frame */
+  uint32_t payload_count;
+  /** payloads dropped while this frame was assembled (UVC error bit or iso packet status != 0) */
+  uint32_t error_payload_count;

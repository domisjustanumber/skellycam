+/** skellycam patch: application control of the isochronous alt setting.
+ * Call after uvc_stream_open_ctrl() and before uvc_stream_start().
+ * @param altsetting >0: use exactly this bAlternateSetting (even if its packets are
+ *        smaller than the negotiated dwMaxPayloadTransferSize); <=0: libuvc's choice
+ * @param min_bytes_per_packet >0: choose the first alt whose packets are at least this
+ *        big, instead of dwMaxPayloadTransferSize; 0: negotiated value
+ * @param packets_per_transfer >0: iso packets per libusb transfer; 0: libuvc default
+ */
+uvc_error_t uvc_stream_set_iso_override(uvc_stream_handle_t *strmh, int altsetting,
+    size_t min_bytes_per_packet, int packets_per_transfer) {
+  if (!strmh || strmh->running)
+    return UVC_ERROR_INVALID_PARAM;
+  strmh->iso_force_altsetting = altsetting;
+  strmh->iso_min_bytes_per_packet = min_bytes_per_packet;
+  strmh->iso_packets_per_transfer = packets_per_transfer;
+  return UVC_SUCCESS;
+}
+
+/** skellycam patch: what uvc_stream_start() selected (0s for bulk / not started). */
+void uvc_stream_get_iso_info(uvc_stream_handle_t *strmh, int *altsetting,
+    size_t *bytes_per_packet, int *packets_per_transfer, int *num_transfers) {
+  if (altsetting) *altsetting = strmh->iso_chosen_altsetting;
+  if (bytes_per_packet) *bytes_per_packet = strmh->iso_chosen_bytes_per_packet;
+  if (packets_per_transfer) *packets_per_transfer = strmh->packets_per_transfer;
+  if (num_transfers) *num_transfers = LIBUVC_NUM_TRANSFER_BUFS;
+}

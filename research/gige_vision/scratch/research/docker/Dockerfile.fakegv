FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      aravis-tools aravis-tools-cli python3 python3-venv libpython3.12t64 ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/gen && /opt/gen/bin/pip install -q genicam==1.6.0

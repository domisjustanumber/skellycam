{
  "name": "skellycam",
  "version": "2.0.0-alpha.6",
  "main": "dist-electron/main/index.js",
  "description": "SkellyCam - the camera backend for the FreeMoCap software.",
  "author": "Skelly FreeMocap <info@freemocap.org>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/freemocap/skellycam",
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "test:recording-shutdown": "node --experimental-strip-types --test tests/graceful-python-shutdown.test.mjs",
    "test:player:unit": "node --experimental-strip-types --test \"src/player/tests/unit/**/*.test.ts\" \"src/components/playback/tests/**/*.test.ts\"",
    "test:player:browser": "vite build -c vite.player-harness.config.ts && playwright test -c playwright.player.config.ts",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "tsc && vite build && electron-builder",
    "build:dev": "tsc && vite build && electron-builder --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "preview": "vite preview",
    "pree2e": "vite build --mode=test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.14.0",
    "@trpc/client": "11.28.6",
    "@trpc/server": "11.28.6",
    "clsx": "2.1.1",
    "country-flag-icons": "1.6.20",
    "d3": "7.9.2",
    "electron-updater": "6.8.11",
    "i18next": "27.1.5",
    "i18next-browser-languagedetector": "8.3.1",
    "react-grid-layout": "2.3.0",
    "react-i18next": "18.0.2",
    "react-redux": "9.3.1",
    "react-resizable-panels": "3.0.6",
    "react-router-dom": "7.18.5",
    "superjson": "2.2.6",
    "tree-kill": "1.2.2",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.68.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/d3": "7.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cross-env": "10.1.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-devtools-installer": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-electron": "1.2.0",
    "vite-plugin-electron-renderer": "1.0.0"
  }
}
